@model IEnumerable<SpiceGarden.Models.Category>
@{
    ViewData["Title"] = "Manage Categories";
}
<div class="container py-4"><h1 class="display-5 fw-bold">Categories</h1><form asp-action="AddCategory" method="post" class="row g-2 mb-3"><div class="col-md-8"><input name="name" class="form-control" placeholder="New category name" required /></div><div class="col-md-4"><button class="btn btn-gold w-100" type="submit">Add category</button></div></form><div class="table-responsive"><table class="table"><thead><tr><th>Id</th><th>Name</th><th>Actions</th></tr></thead><tbody>@foreach(var category in Model){<tr><td>@category.Id</td><td>@category.Name</td><td><form asp-action="EditCategory" method="post" class="d-inline"><input type="hidden" name="id" value="@category.Id" /><input name="name" value="@category.Name" class="form-control form-control-sm d-inline-block w-auto" /><button class="btn btn-sm btn-outline-dark" type="submit">Edit</button></form><form asp-action="DeleteCategory" method="post" class="d-inline"><input type="hidden" name="id" value="@category.Id" /><button class="btn btn-sm btn-outline-danger ms-1" type="submit">Delete</button></form></td></tr>}</tbody></table></div></div>