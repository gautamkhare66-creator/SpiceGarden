@model SpiceGarden.Models.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="container py-4"><div class="d-flex justify-content-between"><div><h1 class="display-5 fw-bold">Admin dashboard</h1><p class="text-muted">Restaurant overview and management tools.</p></div><span class="badge bg-success">Live</span></div><div class="row g-3 my-4"><div class="col-md-6 col-lg-3"><div class="card stat-card"><div class="card-body"><i class="bi bi-people text-primary fs-3"></i><h4>@Model.TotalUsers</h4><span>Users</span></div></div></div><div class="col-md-6 col-lg-3"><div class="card stat-card"><div class="card-body"><i class="bi bi-box-seam text-success fs-3"></i><h4>@Model.TotalOrders</h4><span>Orders</span></div></div></div><div class="col-md-6 col-lg-3"><div class="card stat-card"><div class="card-body"><i class="bi bi-hourglass-split text-warning fs-3"></i><h4>@Model.PendingOrders</h4><span>Pending orders</span></div></div></div><div class="col-md-6 col-lg-3"><div class="card stat-card"><div class="card-body"><i class="bi bi-calendar-check text-info fs-3"></i><h4>@Model.TotalReservations</h4><span>Reservations</span></div></div></div></div><div class="row g-3"><div class="col-md-6"><a class="admin-link" asp-controller="Admin" asp-action="Menu"><i class="bi bi-collection"></i> Manage menu items</a></div><div class="col-md-6"><a class="admin-link" asp-controller="Admin" asp-action="Orders"><i class="bi bi-box"></i> View and update orders</a></div><div class="col-md-6"><a class="admin-link" asp-controller="Admin" asp-action="Reservations"><i class="bi bi-calendar"></i> Manage reservations</a></div><div class="col-md-6"><a class="admin-link" asp-controller="Admin" asp-action="Users"><i class="bi bi-person-badge"></i> View users</a></div></div></div>