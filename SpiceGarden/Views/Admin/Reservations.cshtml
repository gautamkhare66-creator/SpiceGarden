@model IEnumerable<SpiceGarden.Models.Reservation>
@{
    ViewData["Title"] = "Manage Reservations";
}
<div class="container py-4"><h1 class="display-5 fw-bold">Reservations</h1><div class="table-responsive"><table class="table"><thead><tr><th>Customer</th><th>Email</th><th>Date / time</th><th>Guests</th><th>Status</th><th>Update</th></tr></thead><tbody>@foreach(var reservation in Model){<tr><td>@reservation.CustomerName</td><td>@reservation.Email</td><td>@reservation.ReservationDate.ToString("dd MMM") · @reservation.ReservationTime</td><td>@reservation.NumberOfGuests</td><td><span class="badge bg-warning text-dark">@reservation.Status</span></td><td><form asp-action="UpdateReservationStatus" method="post" class="d-inline"><input type="hidden" name="id" value="@reservation.Id" /><select name="status" class="form-select form-select-sm"><option value="Pending" selected="@(reservation.Status == "Pending")">Pending</option><option value="Confirmed" selected="@(reservation.Status == "Confirmed")">Confirmed</option><option value="Rejected" selected="@(reservation.Status == "Rejected")">Rejected</option><option value="Completed" selected="@(reservation.Status == "Completed")">Completed</option></select><button class="btn btn-sm btn-dark ms-1" type="submit">Save</button></form></td></tr>}</tbody></table></div></div>