@using SpiceGarden.Models
@{
    ViewData["Title"] = "Fresh Indian Flavours";
    var featuredItems = (IEnumerable<MenuItem>)ViewData["FeaturedItems"]!;
}
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5 py-5 py-lg-6">
            <div class="col-lg-7">
                <span class="eyebrow"><i class="bi bi-star-fill"></i> Made with heart, served with warmth</span>
                <h1 class="display-5 fw-bold text-white mt-3">Where every plate feels like a <span class="text-gold">celebration.</span></h1>
                <p class="lead text-white-50 fs-5">Discover comforting Indian classics, bold spices, and family-friendly flavours at your neighbourhood’s new favourite garden.</p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a class="btn btn-gold btn-lg" asp-controller="Menu" asp-action="Index">Explore our menu <i class="bi bi-arrow-right ms-2"></i></a>
                    <a class="btn btn-outline-light btn-lg" asp-controller="Reservation" asp-action="Index">Reserve a table</a>
                </div>
                <div class="d-flex flex-wrap gap-4 mt-4 text-white-50"><span><i class="bi bi-clock text-gold"></i> Open daily · 11 AM – 11 PM</span><span><i class="bi bi-geo-alt text-gold"></i> South Avenue, City</span></div>
            </div>
            <div class="col-lg-5"><div class="hero-image-wrap"><img src="https://images.unsplash.com/photo-1585937421612-70a008356fbe?auto=format&fit=crop&w=1200&q=85" alt="SpiceGarden Indian feast" class="hero-image" /><div class="floating-card"><strong>4.9</strong><span><i class="bi bi-star-fill text-gold"></i> Guest rating</span></div></div></div>
        </div>
    </div>
</section>
<section class="section-pad bg-white">
    <div class="container">
        <div class="section-heading text-center"><span class="eyebrow eyebrow-dark">A little taste of home</span><h2 class="display-5 fw-bold">Our favourites, fresh from the kitchen</h2><p>Thoughtfully prepared dishes made for sharing, savouring, and coming back for more.</p></div>
        <div class="row g-4 mt-2">
            @foreach (var item in featuredItems.Take(3)) { <div class="col-md-4"><div class="card h-100 shadow-sm border-0"><img src="@item.ImageUrl" class="card-img-top featured-image" alt="@item.Name" /><div class="card-body"><div class="d-flex justify-content-between"><h5 class="fw-bold">@item.Name</h5><span class="text-success fw-bold">₹@item.Price</span></div><p class="text-muted small">@item.Description</p><a class="btn btn-outline-dark btn-sm" asp-controller="Menu" asp-action="Index">View menu</a></div></div></div> }
        </div>
    </div>
</section>
<section class="section-pad bg-cream">
    <div class="container"><div class="row g-4 align-items-center"><div class="col-lg-5"><span class="eyebrow eyebrow-dark">Why SpiceGarden</span><h2 class="display-5 fw-bold">Good food. Good company. Good memories.</h2><p class="text-muted">We believe a great meal starts with fresh ingredients, honest cooking, and a warm welcome.</p><a class="btn btn-dark" asp-controller="Menu" asp-action="Index">Find your favourite</a></div><div class="col-lg-7"><div class="row g-3"><div class="col-sm-6"><div class="feature-card"><i class="bi bi-leaf text-success fs-3"></i><h4>Fresh ingredients</h4><p>Locally sourced produce and carefully selected spices.</p></div></div><div class="col-sm-6"><div class="feature-card"><i class="bi bi-heart text-danger fs-3"></i><h4>Made with care</h4><p>Comforting food prepared fresh, every single day.</p></div></div><div class="col-sm-6"><div class="feature-card"><i class="bi bi-people text-primary fs-3"></i><h4>Warm hospitality</h4><p>Friendly service that makes every visit feel easy.</p></div></div></div></div></div></div>
</section>
<section class="section-pad bg-dark text-white"><div class="container"><div class="row g-5 align-items-center"><div class="col-lg-6"><img src="https://images.unsplash.com/photo-1552566626-52f8b828add9?auto=format&fit=crop&w=1200&q=85" class="img-fluid rounded-4" alt="Restaurant dining area" /></div><div class="col-lg-6"><span class="eyebrow">Our story</span><h2 class="display-5 fw-bold">A garden where the table is always set.</h2><p class="text-white-50">SpiceGarden was created for people who love rich Indian flavours and the simple joy of sharing good food. Our menu brings familiar favourites together with a modern, welcoming experience.</p><a class="btn btn-gold mt-3" asp-controller="Reservation" asp-action="Index">Book your table</a></div></div></div></section>
