@using SpiceGarden.Models
@using SpiceGarden.Services
@{
    var cart = (IEnumerable<CartItem>)ViewData["Cart"]!;
    var itemList = cart.ToList();
    var subtotal = CartService.GetSubtotal(Context);
}
<div class="container"><div class="row"><div class="col-lg-8"><h1 class="display-5 fw-bold">Your cart</h1><a class="text-muted" asp-controller="Menu" asp-action="Index">Continue shopping</a>@if(!itemList.Any()){<div class="card mt-4 p-5 text-center"><i class="bi bi-cart-x fs-1 d-block text-muted"></i><h4 class="mt-3">Your cart is empty</h4><a class="btn btn-dark" asp-controller="Menu" asp-action="Index">Browse menu</a></div>}else{<div class="list-group mt-4">@foreach(var item in itemList){<div class="list-group-item"><div class="row align-items-center"><img src="@item.ImageUrl" class="cart-thumb" alt="@item.Name" /><div class="col-md-5"><h5 class="mb-1">@item.Name</h5><strong>₹@item.Price</strong></div><div class="col-md-4"><form asp-controller="Cart" asp-action="UpdateQuantity" method="post" class="row g-2"><input type="hidden" name="menuItemId" value="@item.MenuItemId" /><div class="col-5"><input name="quantity" type="number" min="0" max="20" value="@item.Quantity" class="form-control form-control-sm" /></div><div class="col-7"><button class="btn btn-outline-dark btn-sm" type="submit">Update</button></div></form></div><div class="col-md-3 text-end"><strong>₹@item.Subtotal</strong><form asp-controller="Cart" asp-action="Remove" method="post" class="mt-2"><input type="hidden" name="menuItemId" value="@item.MenuItemId" /><button class="btn btn-link text-danger p-0" type="submit"><i class="bi bi-trash"></i></button></form></div></div></div>}</div><form asp-controller="Cart" asp-action="Clear" method="post"><button class="btn btn-link text-muted mt-3" type="submit">Clear cart</button></form>}</div><div class="col-lg-4"><div class="card sticky-top" style="top:100px"><div class="card-body"><h4>Order summary</h4><div class="d-flex justify-content-between"><span>Subtotal</span><strong>₹@subtotal</strong></div><div class="d-flex justify-content-between"><span>Delivery</span><strong class="text-success">Free</strong></div><hr /><div class="d-flex justify-content-between"><strong>Total</strong><strong class="fs-4">₹@subtotal</strong></div>@if(itemList.Any()){<a class="btn btn-gold w-100 mt-3" asp-controller="Checkout" asp-action="Index">Proceed to checkout</a>}</div></div></div></div></div>