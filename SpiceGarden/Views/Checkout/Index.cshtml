@using SpiceGarden.Models.ViewModels
@using SpiceGarden.Models
@model CheckoutViewModel
@{
    var cart = (IEnumerable<CartItem>)ViewData["Cart"]!;
    var subtotal = cart.Sum(i => i.Subtotal);
}
<div class="container py-4"><h1 class="display-5 fw-bold">Checkout</h1><div class="row g-4"><div class="col-lg-7"><form asp-action="PlaceOrder" method="post"><div class="card mb-4"><div class="card-body"><h4 class="mb-3">Customer information</h4><div class="row g-3"><div class="col-md-6"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control" /><span asp-validation-for="CustomerName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-12"><label asp-for="DeliveryAddress" class="form-label"></label><textarea asp-for="DeliveryAddress" class="form-control" rows="3"></textarea><span asp-validation-for="DeliveryAddress" class="text-danger"></span></div><div class="col-12"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" placeholder="Optional phone number" /><span asp-validation-for="Phone" class="text-danger"></span></div></div></div></div><button class="btn btn-gold btn-lg w-100" type="submit">Place order · ₹@subtotal</button></form></div><div class="col-lg-5"><div class="card"><div class="card-body"><h4>Order summary</h4>@foreach(var item in cart){<div class="d-flex justify-content-between mb-2"><span>@item.Quantity × @item.Name</span><strong>₹@item.Subtotal</strong></div>}<hr /><div class="d-flex justify-content-between"><strong>Total</strong><strong class="fs-4">₹@subtotal</strong></div></div></div></div></div></div>