@model SpiceGarden.Models.ViewModels.ReservationViewModel
@{
    ViewData["Title"] = "Reserve a Table";
}
<div class="container py-4"><div class="row justify-content-center"><div class="col-lg-8"><div class="card shadow-sm"><div class="card-body p-4"><span class="eyebrow eyebrow-dark">Table for you</span><h1 class="display-5 fw-bold">Reserve a table</h1><p class="text-muted">Tell us when you are coming and we will hold your table.</p><form asp-action="Create" method="post"><div asp-validation-summary="All" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CustomerName" class="form-label"></label><input asp-for="CustomerName" class="form-control" /><span asp-validation-for="CustomerName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /><span asp-validation-for="Phone" class="text-danger"></span></div><div class="col-md-3"><label asp-for="ReservationDate" class="form-label"></label><input asp-for="ReservationDate" class="form-control" /><span asp-validation-for="ReservationDate" class="text-danger"></span></div><div class="col-md-3"><label asp-for="ReservationTime" class="form-label"></label><select asp-for="ReservationTime" class="form-select"><option value="12:00">12:00 PM</option><option value="13:00">1:00 PM</option><option value="14:00">2:00 PM</option><option value="18:00">6:00 PM</option><option value="19:00">7:00 PM</option><option value="20:00">8:00 PM</option><option value="21:00">9:00 PM</option></select></div><div class="col-md-6"><label asp-for="NumberOfGuests" class="form-label"></label><input asp-for="NumberOfGuests" class="form-control" /><span asp-validation-for="NumberOfGuests" class="text-danger"></span></div><div class="col-12"><label asp-for="SpecialRequest" class="form-label">Special request (optional)</label><textarea asp-for="SpecialRequest" class="form-control" rows="3"></textarea></div><div class="col-12"><button class="btn btn-gold w-100" type="submit">Submit reservation</button></div></div></form></div></div></div></div>